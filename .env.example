# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Ваш chat_id (необязательно) — сюда бот пишет, если сайт перестал отвечать
ADMIN_CHAT_ID=
# Как часто проверять сайт, минут
CHECK_INTERVAL_MIN=10
# За сколько минут предупреждать об отключении (0 — не предупреждать)
REMIND_BEFORE_MIN=30
# Где хранить базу
DB_PATH=data/bot.sqlite3
TZ=Europe/Kyiv
